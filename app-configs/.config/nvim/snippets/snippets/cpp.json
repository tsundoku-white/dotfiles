{
  "Class with Rule of 5 (.hpp/.h style)": {
    "prefix": "class5",
    "body": [
      "namespace ${1:my_namespace}",
      "{",
      "  class ${2:MyClass}",
      "  {",
      "    private:",
      "",
      "    public:",
      "      // -- Class Data Management -----------------",
      "      // Constructor",
      "      ${2:MyClass}();",
      "",
      "      // Destructor",
      "      ~${2:MyClass}();",
      "",
      "      // Copy Constructor",
      "      ${2:MyClass}(const ${2:MyClass}& other);",
      "",
      "      // Copy Assignment Operator",
      "      ${2:MyClass}& operator=(const ${2:MyClass}& other);",
      "",
      "      // Move Constructor",
      "      ${2:MyClass}(${2:MyClass}&& other) noexcept;",
      "",
      "      // Move Assignment Operator",
      "      ${2:MyClass}& operator=(${2:MyClass}&& other) noexcept;",
      "  };",
      "}",
      "$0"
    ],
    "description": "Full class with Rule of 5 declarations (header)"
  },

  "Class with Rule of 5 (.cc/.cpp implementation)": {
    "prefix": "class5cc",
    "body": [
      "#include \"${1:MyClass}.hpp\"",
      "",
      "namespace ${2:my_namespace}",
      "{",
      "  // Constructor",
      "  ${1:MyClass}::${1:MyClass}()",
      "  {",
      "    $0",
      "  }",
      "",
      "  // Destructor",
      "  ${1:MyClass}::~${1:MyClass}()",
      "  {",
      "  }",
      "",
      "  // Copy Constructor",
      "  ${1:MyClass}::${1:MyClass}(const ${1:MyClass}& other)",
      "  {",
      "  }",
      "",
      "  // Copy Assignment Operator",
      "  ${1:MyClass}& ${1:MyClass}::operator=(const ${1:MyClass}& other)",
      "  {",
      "    if (this != &other)",
      "    {",
      "    }",
      "    return *this;",
      "  }",
      "",
      "  // Move Constructor",
      "  ${1:MyClass}::${1:MyClass}(${1:MyClass}&& other) noexcept",
      "  {",
      "  }",
      "",
      "  // Move Assignment Operator",
      "  ${1:MyClass}& ${1:MyClass}::operator=(${1:MyClass}&& other) noexcept",
      "  {",
      "    if (this != &other)",
      "    {",
      "    }",
      "    return *this;",
      "  }",
      "}"
    ],
    "description": "Rule of 5 method implementations (source)"
  }
}

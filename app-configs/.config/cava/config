## Cava config - uses your terminal's own color scheme (no hardcoded hex)

[general]
mode = normal
framerate = 144
autosens = 1
sensitivity = 170
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 0

[input]
method = pulse
source = auto

[output]
method = noncurses
orientation = bottom
channels = stereo
mono_option = average
reverse = 0
xaxis = none

[color]
# 'default' pulls whatever your terminal emulator's background/foreground
# colors are set to, so it matches your theme automatically.
background = default
foreground = default
gradient = 0

[smoothing]
noise_reduction = 77
monstercat = 0
waves = 1

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
